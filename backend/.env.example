# Copiez ce fichier en backend/.env et remplissez vos clés.
# Ne commitez JAMAIS backend/.env (il est exclu par le .gitignore).

# --- IA gratuites pour la conversation ---
# Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq : https://console.groq.com/keys
GROQ_API_KEY=

# Ordre d'essai : si Gemini atteint sa limite gratuite ou ne répond pas, OkapiAI passe à Groq
OKAPI_LLM_PROVIDERS=gemini,groq

# Modèles (facultatif : à changer si un service retire un modèle)
# OKAPI_GEMINI_MODEL=gemini-flash-lite-latest   (ou gemini-flash-latest, plus fort mais souvent saturé)
# OKAPI_GROQ_MODEL=openai/gpt-oss-120b

# --- Sécurité (à changer avant toute mise en ligne) ---
# OKAPI_SECRET_KEY=
# OKAPI_ADMIN_PASSWORD=
